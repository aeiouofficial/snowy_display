{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowy Display",
  "version": "0.1.0",
  "identifier": "io.aeiouofficial.snowydisplay",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Snowy Display", "width": 475, "height": 760,
        "minWidth": 360, "minHeight": 570, "visible": false, "backgroundColor": "#0a111d" }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "category": "Utility" }
}
