@echo off
rem Snowy Display: keep ALL mutable build, cache and temp data on S:.
rem This script does not open any windows; invoke from a hidden/background runner.
set "SNOWY_WORKSPACE=S:\snowy_display"
set "TEMP=%SNOWY_WORKSPACE%\.tmp"
set "TMP=%SNOWY_WORKSPACE%\.tmp"
set "TMPDIR=%SNOWY_WORKSPACE%\.tmp"
set "HOME=%SNOWY_WORKSPACE%\.home"
set "USERPROFILE=%SNOWY_WORKSPACE%\.home"
set "HOMEDRIVE=S:"
set "HOMEPATH=\snowy_display\.home"
set "APPDATA=%SNOWY_WORKSPACE%\.home\AppData\Roaming"
set "LOCALAPPDATA=%SNOWY_WORKSPACE%\.home\AppData\Local"
set "XDG_CACHE_HOME=%SNOWY_WORKSPACE%\.cache"
set "XDG_CONFIG_HOME=%SNOWY_WORKSPACE%\.home\config"
set "npm_config_cache=%SNOWY_WORKSPACE%\.cache\npm"
set "npm_config_prefix=%SNOWY_WORKSPACE%\.cache\npm-prefix"
set "npm_config_update_notifier=false"
set "CARGO_HOME=%SNOWY_WORKSPACE%\.cache\cargo"
set "CARGO_TARGET_DIR=%SNOWY_WORKSPACE%\.build\target"
set "RUSTUP_HOME=%SNOWY_WORKSPACE%\.cache\rustup"
set "PYTHONPYCACHEPREFIX=%SNOWY_WORKSPACE%\.cache\python"
set "NODE_COMPILE_CACHE=%SNOWY_WORKSPACE%\.cache\node-compile"
set "GIT_CONFIG_GLOBAL=%SNOWY_WORKSPACE%\.home\.gitconfig"
set "RUSTC=C:\Users\BigBr\.rustup\toolchains\stable-x86_64-pc-windows-msvc\bin\rustc.exe"
set "RUSTDOC=C:\Users\BigBr\.rustup\toolchains\stable-x86_64-pc-windows-msvc\bin\rustdoc.exe"
set "PATH=C:\Users\BigBr\.rustup\toolchains\stable-x86_64-pc-windows-msvc\bin;%PATH%"
for %%D in ("%TEMP%" "%APPDATA%" "%LOCALAPPDATA%" "%CARGO_HOME%" "%CARGO_TARGET_DIR%" "%XDG_CONFIG_HOME%" "%npm_config_cache%" "%NODE_COMPILE_CACHE%") do if not exist "%%~D" mkdir "%%~D"
cd /d "%SNOWY_WORKSPACE%"
