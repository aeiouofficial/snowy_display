    "check": "tsc --noEmit && node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  }
}
