{
  "name": "snowy-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "tsc --noEmit && vite build",
